}

void ng_int_array_set(ng_int_array_t *arr, int64_t index, int64_t value) {
  arr->data[ng_array_checked_index(index, arr->len)] = value;
}

void ng_int2_array_set(ng_int2_array_t *arr, int64_t index, ng_int_array_t value) {
  arr->data[ng_array_checked_index(index, arr->len)] = value;
}

