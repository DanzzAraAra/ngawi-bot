import "src/logger.ngawi";

fn main() -> int {
    let config = json_read("settings.json");
    let prefix = json_get(config, "prefix");
    let token = json_get(config, "bot.token");
    let bot_name = json_get(config, "bot.name");
    let owner_name = json_get(config, "owner.name");
    let api_url = json_get(config, "api.baseUrl");
    let api_key = json_get(config, "api.key");
    let api_header = json_get(config, "api.header");
    api_config(api_url, api_key, api_header);
    let offset = 0;

    log_start(bot_name);
    log_plugin(plugin_count());
    log_info("Connecting...");

    log_success("Bot is ready to receive messages");

    while (true) {
        let updates = rusdi_get_update(token, offset);
        let count = telegram_count(updates);

        for (let i: int = 0; i < count; i++) {
            let text = telegram_text(updates, i);
            let chat = telegram_chat_id(updates, i);
            let id = telegram_update_id(updates, i);

            log_message(chat, "Telegram User", text);

            for (let j: int = 0; j < plugin_count(); j++) {
                let command = plugin_name(j);

                let command_prefix = prefix + command;

                if (text == command_prefix || starts_with(text, command_prefix + " ")) {
                    let args = trim(string_slice(text, len(command_prefix)));

                    log_command(chat, command, "Telegram User");

                    dispatch_command(
                        token,
                        chat,
                        command,
                        bot_name,
                        owner_name,
                        prefix,
                        args
                    );
                }
            }

            offset = id + 1;
        }
    }

    return 0;
}